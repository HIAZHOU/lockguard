# 复制本文件为 local.env，按你的机器改路径。local.env 已被 .gitignore 忽略，不会提交。
#
# 路径请用 Windows 风格（D:\xxx）：Gradle 的 gradle.bat / adb.exe 只认这种写法，
# 写成 /d/xxx 会被 cmd 当成当前盘下的相对路径。
#
# 也可以不建这个文件，直接把同名环境变量设好即可。

# 必填：Android SDK 根目录（需含 platform-tools、platforms;android-35、build-tools）
ANDROID_HOME=C:\Android\Sdk

# 可选：Gradle 解压目录（不设则用 PATH 上的 gradle）
GRADLE_HOME=C:\Gradle\gradle-8.9

# 可选：Gradle 依赖缓存目录（不设则用 %USERPROFILE%\.gradle）
GRADLE_USER_HOME=C:\Gradle\cache

# 可选：JDK 17 安装目录（不设则用系统默认 java）
JAVA_HOME=C:\Program Files\Java\jdk-17
